rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Allow guest checkouts, admin status updates and order tracking
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Products catalog collection: Allow catalog reading and admin inventory updates
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // VIP Newsletter subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow read: if true;
      allow write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
